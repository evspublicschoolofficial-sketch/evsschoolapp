{
  "version": 2,
  "headers": [
    {
      "source": "/(index\\.html|sw\\.js|version\\.json)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|api/|ws/|version\\.json|sw\\.js|manifest\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
